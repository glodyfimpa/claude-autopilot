# Claude Code local state — entire root .claude/ directory
# (settings, settings.local, worktrees, plans, memory, todos, and any future
# state files Claude Code introduces). Anchored at root so it does NOT match
# nested .claude/ directories elsewhere in the tree.
/.claude/

# Autopilot state generated when the plugin is run from inside its own repo.
# /tasks/ is anchored to the root so it does NOT match backlog/tasks/ which
# is part of the backlog.md tracker and MUST be committed.
.autopilot-pipeline.json
/tasks/

# OS / editor noise
.DS_Store
.vscode/
.idea/
*.swp
*.swo
*~

# sed -i.bak safety net + merge leftovers
*.bak
*.orig
*.rej

# Logs
*.log
